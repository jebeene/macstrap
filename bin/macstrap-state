#!/bin/bash

STATE_DIR="$HOME/.local/state/macstrap"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"

if [[ -z $COMMAND || -z $STATE_NAME ]]; then
  echo "Usage: macstrap-state <set|clear> <state-name>"
  exit 1
fi

case "$COMMAND" in
  set)   touch "$STATE_DIR/$STATE_NAME" ;;
  clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Usage: macstrap-state <set|clear> <state-name>"
    exit 1
    ;;
esac

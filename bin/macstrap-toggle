#!/bin/bash

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification)  ENABLED_NOTIFICATION="$2";  shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/macstrap/toggles/$FLAG_NAME"

if [[ -f $FLAG ]]; then
  rm "$FLAG"
  [[ -n $DISABLED_NOTIFICATION ]] && osascript -e "display notification \"$DISABLED_NOTIFICATION\" with title \"macstrap\""
else
  mkdir -p "$(dirname "$FLAG")"
  touch "$FLAG"
  [[ -n $ENABLED_NOTIFICATION ]] && osascript -e "display notification \"$ENABLED_NOTIFICATION\" with title \"macstrap\""
fi

#!/bin/bash
# Rebuild ~/.config/aerospace/aerospace.toml from macstrap defaults + user bindings and reload AeroSpace

set -euo pipefail

DEFAULTS="$MACSTRAP_PATH/default/aerospace"
USER_BINDINGS="$HOME/.config/macstrap/aerospace/bindings.toml"
OUTPUT="$HOME/.config/aerospace/aerospace.toml"

mkdir -p "$(dirname "$OUTPUT")"

# Seed user bindings from macstrap default if not yet created
if [[ ! -f "$USER_BINDINGS" ]]; then
  mkdir -p "$(dirname "$USER_BINDINGS")"
  cp "$MACSTRAP_PATH/config/aerospace/bindings.toml" "$USER_BINDINGS"
fi

{
  # AeroSpace system configuration — managed by macstrap (READ-ONLY)
  # Rebuilt from default/aerospace/ by macstrap-refresh-aerospace
  # To customize shortcuts: edit ~/.config/macstrap/aerospace/bindings.toml

  cat "$DEFAULTS/autostart.toml"
  echo
  cat "$DEFAULTS/input.toml"
  echo
  cat "$DEFAULTS/looknfeel.toml"
  echo

  # App-specific window rules — add files to default/aerospace/apps/ to extend
  for f in "$DEFAULTS"/apps/*.toml; do
    [[ -f "$f" ]] || continue
    cat "$f"
    echo
  done

  echo '[mode.main.binding]'
  echo

  # System WM bindings (bare key = value pairs, assembled in order)
  for name in focus workspaces navigation; do
    cat "$DEFAULTS/bindings/$name.toml"
    echo
  done

  # User app-launcher bindings
  cat "$USER_BINDINGS"
  echo

  # Service mode (owns its own section header)
  cat "$DEFAULTS/bindings/service.toml"
} > "$OUTPUT"

if [[ "${1:-}" != "--no-reload" ]]; then
  aerospace reload-config
  echo "AeroSpace config reloaded."
fi

#!/bin/bash

# macstrap:summary=Apply the current theme to running nvim instances
# macstrap:hidden=true

for pid in $(pgrep nvim 2>/dev/null); do
  socket=$(lsof -p "$pid" -a -U 2>/dev/null | awk 'NR>1 {print $NF; exit}')
  [[ -n $socket ]] || continue
  nvim --server "$socket" --remote-send "<cmd>lua vim.api.nvim_exec_autocmds('User', {pattern='LazyReload'})<cr>" 2>/dev/null &
done

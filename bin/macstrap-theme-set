#!/bin/bash

# macstrap:summary=Apply a macstrap theme
# macstrap:args=<theme-name>
# macstrap:examples=macstrap theme list | macstrap theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: macstrap-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/macstrap/current/theme"
NEXT_THEME_PATH="$HOME/.config/macstrap/current/next-theme"
USER_THEMES_PATH="$HOME/.config/macstrap/themes"
MACSTRAP_THEMES_PATH="$MACSTRAP_PATH/themes"

THEME_NAME=$(echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $MACSTRAP_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$MACSTRAP_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate dynamic configs from templates
macstrap-theme-set-templates

# Atomic swap
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/macstrap/current/theme.name"

# Reload apps
macstrap-restart-ghostty
macstrap-restart-tmux

# Call hook on theme set
macstrap-hook theme-set "$THEME_NAME" >/dev/null

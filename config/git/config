# See https://git-scm.com/docs/git-config
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
  ss = log main..HEAD --stat
[init]
	defaultBranch = master
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	true-color = always
	line-numbers = true
	hyperlinks = true
	side-by-side = true
	wrap-max-lines = 0
	zero-style = dim syntax
	syntax-theme = "Monokai Extended"
	merge-conflict-style = diff-3
	word-diff-regex = "[^[:space:]]+"
	file-style = bold "#e0e0e0" "#1e3a5f"
	file-decoration-style = "#56b4e9" box
	file-added-label = U
	file-modified-label = M
	file-removed-label = D
	file-renamed-label = R
	hunk-header-style = file line-number "#888888"
	hunk-header-decoration-style = "#333333" ul
	commit-style = bold "#e69f00"
	commit-decoration-style = "#e69f00" box
	blame-palette = "#1a1a2e" "#16213e" "#0f3460" "#1a2744" "#2d1b45"
	# Okabe-Ito colorblind-safe palette: orange for removed, blue for added
	minus-style                   = syntax "#3d1c00"
	minus-emph-style              = syntax "#7a3800"
	minus-empty-line-marker-style = normal "#3d1c00"
	plus-style                    = syntax "#00243d"
	plus-emph-style               = syntax "#004880"
	plus-empty-line-marker-style  = normal "#00243d"
	line-numbers-minus-style      = "#e69f00"
	line-numbers-plus-style       = "#56b4e9"
